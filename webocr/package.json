{
  "name": "webocr",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build --base-href /webocr/",
    "ng": "ng",
    "postbuild": "bread-compressor dist/app/browser",
    "serve-dist": "ws --hostname localhost -d dist/app/browser -p 1234 -o --log.format stats",
    "start": "ng serve",
    "format": "npx prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.8",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "22.0.8",
    "@angular/router": "22.0.8",
    "@ionic/angular": "8.8.15",
    "ionicons": "8.0.13",
    "rxjs": "7.8.2",
    "tesseract.js": "7.0.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@ionic/angular-toolkit": "12.3.0",
    "@types/node": "26.1.1",
    "bread-compressor-cli": "4.1.0",
    "local-web-server": "5.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
